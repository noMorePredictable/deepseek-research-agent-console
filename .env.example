# 必填：DeepSeek 聊天模型
DEEPSEEK_API_KEY=

# 可选：OpenAI 兼容 Embedding 服务。三项配置完整后启用 BM25 + 向量混合记忆；
# 未配置时自动使用 BM25，不影响研究主链路。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 可选：Langfuse v4。默认只上传长度、哈希和运行元数据，不上传问题与网页正文。
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=0
